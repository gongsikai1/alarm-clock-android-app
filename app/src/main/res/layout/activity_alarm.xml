<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_bg">

    <LinearLayout
        android:id="@+id/ring_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/ring_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:30"
            android:textColor="@color/text"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ring_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="07:30"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ring_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="song.mp3"
            android:textColor="@color/text"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/ring_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="每日 · 响铃 1 分钟"
            android:textColor="@color/text2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ring_swipe_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_chip"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp"
            android:text="↑  上滑划掉闹钟"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="锁屏状态下同样可以划掉"
            android:textColor="@color/text3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/ring_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_ghost"
            android:gravity="center"
            android:paddingStart="30dp"
            android:paddingTop="12dp"
            android:paddingEnd="30dp"
            android:paddingBottom="12dp"
            android:text="关闭闹钟"
            android:textColor="@color/text2"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● 闹钟响铃中"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ring_top_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="✕ 关闭"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
